                            </a>
                        </li>
                    </ul>
                </div>
            </div>



            <div class="d-flex align-items-center">
                <i class="fa-solid fa-bell me-3 text-muted" style="cursor:pointer;"></i>
                <i class="fa-solid fa-message me-3 text-muted" style="cursor:pointer;"></i>

                <img src="@profilePic"
                     class="profile-pic"
                     style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 3px solid #fff;" />
