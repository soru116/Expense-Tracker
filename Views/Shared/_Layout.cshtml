            <div class="d-flex align-items-center me-auto">
                <div class="dropdown">
                    <button class="btn btn-success rounded-circle shadow-none" type="button"
                            id="searchDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                            style="width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-dark shadow-lg mt-3 p-2 border-secondary"
                        aria-labelledby="searchDropdown"
                        style="background-color: #212b36; border: 1px solid #444; border-radius: 12px; min-width: 220px;">

                        <li class="mb-1">
                            <a class="dropdown-item text-white rounded py-2 d-flex align-items-center"
                               href="/Search/GeneralSearch?searchType=Transaction"
                               onmouseover="this.style.backgroundColor='#34495e';"
                               onmouseout="this.style.backgroundColor='transparent';">
                                <div class="icon-box bg-dark rounded-circle me-3 d-flex align-items-center justify-content-center" style="width:35px; height:35px;">
                                    <i class="fa-solid fa-arrow-right-arrow-left text-warning" style="font-size: 0.9rem;"></i>
                                </div>
                                <span class="fw-bold" style="font-size: 0.95rem;">Search Transactions</span>
                            </a>
                        </li>

                        <li><hr class="dropdown-divider border-secondary my-1"></li>

                        <li>
                            <a class="dropdown-item text-white rounded py-2 d-flex align-items-center"
